rules_version = '2';

// FairBid Storage security rules.
service firebase.storage {
  match /b/{bucket}/o {

    // Admins are found by `role` on the Firestore user doc, like firestore.rules.
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
             .data.role == 'admin';
    }

    // Uploads go only to the caller's own folder, and need a verified email.
    function isVerifiedOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true;
    }

    // Verification files: owner reads/writes, admins read. Images or PDF, under 10 MB.
    // `contentType` is client-set, so this is only an accident guard, not security.
    match /verification/{userId}/{allPaths=**} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());
      allow write: if isVerifiedOwner(userId)
                   && request.resource.size > 0
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType != null
                   && (request.resource.contentType == 'application/pdf'
                       || request.resource.contentType.matches('image/.*'));
    }

    // Job photos/video: any signed-in user reads, only the owner writes (max 50 MB).
    match /jobs/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isVerifiedOwner(userId)
                   && request.resource.size < 50 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
    }

    // Dispute photos: the uploader writes; the uploader and admins read.
    match /disputes/{userId}/{allPaths=**} {
      allow read: if request.auth != null
                  && (request.auth.uid == userId || isAdmin());
      allow write: if isVerifiedOwner(userId);
    }

    // Avatars: any signed-in user reads; the owner writes (images only, max 5 MB).
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isVerifiedOwner(userId)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default until its own rule is written.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
