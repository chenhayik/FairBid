rules_version = '2';

// FairBid Firestore security rules.
// Starting point covering the auth/profile flow; extend per feature (jobs,
// bids, milestones, etc.) as they are built.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && roleOf(request.auth.uid) == 'admin';
    }

    // A suspended account keeps read access but is frozen out of every write
    // (posting, bidding, reviewing, chatting, editing its profile). The
    // `suspended` flag is server-owned — set only by the setUserSuspended
    // Cloud Function; the users write rules below forbid any client from
    // setting or clearing it, so a suspended user can't lift their own ban.
    function isSuspended() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('suspended', false) == true;
    }

    // User profiles. Any signed-in user may read a profile (needed to show
    // names/ratings on jobs, bids and chats). A user may create/edit their own
    // document, except for the Trust Score fields (score, breakdown and its
    // raw inputs) and the wallet balance — those are only ever written by
    // Cloud Functions (admin SDK, bypasses rules), so they can't be forged by
    // a client write, at creation time or later. An admin may additionally
    // record a verification decision on any user (only the verification
    // fields), which is how pending providers and requestors are approved
    // into the marketplace. Deletion is client-denied.
    //
    // TODO: walletBalanceSen and escrowLockedSen are still world-readable
    // here too (any signed-in user can read another user's wallet balance).
    // They're written by Cloud Functions and read by the escrow logic, so
    // moving them under private/ is a larger change than the payout/phone
    // move below — deliberately left alone for now.
    match /users/{userId} {
      // 'jobsPosted'/'jobsAssigned'/'hireRate' are the requestor job-posting
      // counters behind the public profile's client-history strip
      // (functions/index.js's bumpJobsPostedOnCreate /
      // bumpJobsAssignedOnAccept) — server-owned exactly like the Trust
      // Score fields, so a client can't forge a higher hire rate.
      function trustFields() {
        return ['trustScore', 'ratingSum', 'ratingCount', 'jobsCompleted',
                'disputesLost', 'trust', 'jobsPosted', 'jobsAssigned',
                'hireRate'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(
                        trustFields().concat(['suspended', 'suspensionReason',
                                              'suspendedAt', 'suspendedBy']))
                    && request.resource.data
                        .get('walletBalanceSen', 0) == 0
                    && request.resource.data
                        .get('escrowLockedSen', 0) == 0;
      allow update: if isSignedIn() && (
                      (request.auth.uid == userId
                          && !isSuspended()
                          && !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(trustFields()
                                  .concat(['walletBalanceSen',
                                           'escrowLockedSen', 'suspended',
                                           'suspensionReason', 'suspendedAt',
                                           'suspendedBy'])))
                      || (isAdmin()
                          && request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['verificationStatus',
                                        'verificationReason',
                                        'reviewedAt']))
                    );
      allow delete: if false;

      // Reviews left on a user's profile after a completed job. Readable by
      // any signed-in user; a reviewer may only create a review as themselves,
      // never on their own profile, and only once the named job is completed
      // and both parties were its participants — this ensures the
      // `recomputeTrustScore` Cloud Function only ever fires for genuine
      // completed-job reviews. Reviews are immutable once written.
      match /reviews/{reviewId} {
        function jobData(jobId) {
          return get(/databases/$(database)/documents/jobs/$(jobId)).data;
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && !isSuspended()
                      && request.resource.data.reviewerId == request.auth.uid
                      && request.auth.uid != userId
                      && jobData(request.resource.data.jobId).status == 'completed'
                      && jobData(request.resource.data.jobId).requestorId
                          in [request.auth.uid, userId]
                      && jobData(request.resource.data.jobId).acceptedProviderId
                          in [request.auth.uid, userId]
                      // Ratings must be a genuine 1–5 star value — otherwise a
                      // forged rating corrupts the reviewee's Trust Score.
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      // One review per reviewer per job: the doc id is bound
                      // to the job + reviewer, matching the client's
                      // deterministic id (see review_repository.dart), so a
                      // reviewer can't spam multiple reviews for one job under
                      // different doc ids.
                      && reviewId == request.resource.data.jobId
                          + '_' + request.auth.uid;
        // One narrow carve-out from immutability: reporting a review for
        // moderation may set the flag fields, once. Hiding/keeping (and the
        // Trust Score reversal) is exclusively the moderateReview Cloud
        // Function, which runs with the admin SDK and bypasses rules.
        allow update: if isSignedIn()
                      && resource.data.flagged != true
                      && request.resource.data.flagged == true
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['flagged', 'flagReason', 'flaggedByUid']);
        allow delete: if false;
      }

      // Sensitive per-user data that must never be world-readable: onboarding
      // identity documents (identity/selfie/ID-document photo URLs, doc id
      // `verification`) and, since payout bank details (bankName,
      // accountHolder, accountLast4, branchCode) and the phone number used to
      // sit on the world-readable doc above, those too (doc id `payout`). The
      // owner writes it; only the owner and admins may read it — so a Storage
      // download URL (whose token bypasses Storage rules) can't be harvested
      // from another user's world-readable profile, and neither can a payout
      // bank detail or phone number.
      match /private/{doc} {
        allow read: if isSignedIn()
                    && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // Notifications are written only by the Cloud Functions (`notify()`);
      // the owner reads their feed and may flip `read`, nothing else. Nested
      // under the user doc so cleanupUserDoc's recursive delete covers them.
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    function isApprovedProvider(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return user.role == 'provider' && user.verificationStatus == 'approved';
    }

    // The caller's own stored Trust Score snapshot, used to pin a bid's
    // `providerTrustScore`/`providerScoreVisible` fields to reality — so a
    // provider can't forge a higher score on their own bid to top the
    // requestor's Best Value ranking.
    function callerTrustScore() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('trustScore', 0);
    }

    function callerScoreVisible() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('trust', {}).get('scoreVisible', false);
    }

    // The caller's own stored avatar, used to pin a bid's `providerPhotoUrl`
    // to reality — so a provider can't put someone else's (or an arbitrary
    // external) image on their bid. `.get(..., null)` means a provider with
    // no photo yet still passes (both sides read as null).
    function callerPhotoUrl() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('profilePhotoUrl', null);
    }

    function ownsJob(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId))
          .data.requestorId == request.auth.uid;
    }

    function isAcceptedProvider(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId))
          .data.acceptedProviderId == request.auth.uid;
    }

    // Bidding is open while the job's status is 'open' AND its optional
    // deadline hasn't passed — even if the closeExpiredJobs sweep hasn't yet
    // flipped an expired job to 'cancelled', so a late bid can't sneak in
    // during that lag.
    function jobBiddingOpen(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return job.status == 'open'
          && (!('deadline' in job) || request.time < job.deadline);
    }

    function jobIsInProgress(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId))
          .data.status == 'in_progress';
    }

    // The only `status` transition a client may write: cancelling a still-open
    // job (open → cancelled). Accepting a bid (open → in_progress) now goes
    // through the acceptBid Cloud Function (it gates on wallet balance), and
    // every other transition — completion, mid-flight cancellation — is
    // likewise owned by a Cloud Function (admin SDK bypasses rules), so a
    // requestor can't self-accept, self-complete or strand escrow by a direct
    // write.
    function jobStatusWriteOk() {
      return request.resource.data.status == resource.data.status
          || (resource.data.status == 'open'
              && request.resource.data.status == 'cancelled');
    }

    // Cancellation audit fields are Cloud-Function-owned: a client must never
    // write them, or a requestor could forge a cancellation request and
    // self-accept it, bypassing the counterparty's consent.
    function noCancelFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['cancellationRequestedBy', 'cancellationReason',
                   'cancellationRequestedAt', 'cancelledAt', 'cancelledBy']);
    }

    // Bid-acceptance fields are Cloud-Function-owned (acceptBid): a client
    // must never write them directly, or a requestor could assign a job
    // without the server's wallet-balance gate.
    function noAcceptFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['acceptedProviderId', 'acceptedProviderName',
                   'acceptedBidAmountSen']);
    }

    // Jobs. Readable by any signed-in user (providers browse). Only a
    // requestor may create their own job; only the owner may edit it (subject
    // to the status/cancellation guards above) — except `bidCount`, which any
    // signed-in user may bump so a provider's bid submit/withdraw batch can
    // keep the counter in sync.
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && !isSuspended()
                    && request.resource.data.requestorId == request.auth.uid
                    && roleOf(request.auth.uid) == 'requestor';
      allow update: if isSignedIn()
                    && ((resource.data.requestorId == request.auth.uid
                         && jobStatusWriteOk()
                         && noCancelFieldWrites()
                         && noAcceptFieldWrites())
                        || request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['bidCount']));
      allow delete: if false;

      // Bids on a job, keyed by the bidding provider's uid (one bid per
      // provider per job). Only approved providers may place or edit their
      // own bid. Accepting/rejecting is server-only (the acceptBid Cloud
      // Function, which gates on wallet balance); a provider may withdraw
      // (delete) their own bid.
      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
                              && !isSuspended()
                              && request.auth.uid == bidId
                              && request.resource.data.providerId == bidId
                              && isApprovedProvider(request.auth.uid)
                              && jobBiddingOpen(jobId)
                              // A negative or absurd amount must never reach
                              // acceptBid, which trusts this stored value
                              // when debiting the requestor's wallet. RM
                              // 1,000,000 is a generous upper cap against
                              // overflow abuse.
                              && request.resource.data.amountSen is int
                              && request.resource.data.amountSen > 0
                              && request.resource.data.amountSen <= 100000000
                              // The Trust Score snapshot must match the
                              // caller's own stored profile — never a value
                              // the client made up.
                              && request.resource.data.providerTrustScore
                                  == callerTrustScore()
                              && request.resource.data
                                  .get('providerScoreVisible', false)
                                  == callerScoreVisible()
                              // Same pin for the photo snapshot — a bid that
                              // omits it entirely (no photo) still passes.
                              && request.resource.data
                                  .get('providerPhotoUrl', null)
                                  == callerPhotoUrl();
        // Withdraw own bid — but only while it's still pending, so a provider
        // can't delete a bid the requestor just accepted and orphan the job's
        // winner fields.
        allow delete: if isSignedIn() && request.auth.uid == bidId
                      && resource.data.status == 'pending';
      }

      // Escrow milestones. The plan is authored server-side by the
      // proposeMilestonePlan / approveMilestonePlan / rejectMilestonePlan
      // Cloud Functions (so the amounts must total the accepted bid and can't
      // be forged), as are funding, release and dispute rulings. The only
      // client-writable change is the money-free funded → submitted delivery
      // mark. All the money-and-plan mutations run with the admin SDK and
      // bypass rules.
      match /milestones/{milestoneId} {
        allow read: if isSignedIn()
                    && (ownsJob(jobId) || isAcceptedProvider(jobId));
        allow create: if false;
        allow update: if isSignedIn() && !isSuspended()
                      && isAcceptedProvider(jobId)
                      && resource.data.status == 'funded'
                      && request.resource.data.status == 'submitted'
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['status', 'submissionNote']);
        allow delete: if false;
      }

      // Per-job activity timeline: a server-written event log (job posted,
      // status transitions, milestone transitions). Written only by Cloud
      // Functions (admin SDK bypasses rules) — like `transactions` and
      // `disputes`, this keeps the log from being forged by a client write.
      // Readable by the job's two participants and admins, mirroring the
      // milestones sub-block above.
      match /events/{eventId} {
        allow read: if isSignedIn()
                    && (ownsJob(jobId) || isAcceptedProvider(jobId) || isAdmin());
        allow write: if false;
      }

      // The requestor's precise service address (street, postcode, access
      // notes), kept private: readable only by the job's owner, its
      // accepted provider and admins — never by other bidders. Written by
      // the owner.
      match /private/{docId} {
        allow read: if isSignedIn()
                    && (ownsJob(jobId) || isAcceptedProvider(jobId) || isAdmin());
        allow create, update: if isSignedIn() && !isSuspended() && ownsJob(jobId);
        allow delete: if false;
      }
    }

    // Collection-group reads for a provider's own cross-job listings — their
    // bids ("Pending Bids") and their milestones (the Earnings figures).
    // Rules v2 only applies `match /{path=**}` rules to collectionGroup
    // queries, so the per-job rules above don't cover these; both queries
    // filter on providerId == the caller, which is exactly what is checked.
    match /{path=**}/bids/{bidId} {
      allow read: if isSignedIn()
                  && resource.data.providerId == request.auth.uid;
    }
    match /{path=**}/milestones/{milestoneId} {
      allow read: if isSignedIn()
                  && resource.data.providerId == request.auth.uid;
    }
    // Admin moderation queue: the flagged-reviews collectionGroup query.
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAdmin();
    }

    // Chat between a job's requestor and its accepted provider. The doc id is
    // `{jobId}_{providerId}`; either participant may lazily create it. Reads
    // and updates are participant-only — updates carry the last-message
    // preview and unread counters, and like the plan's other client-side
    // counter writes, rules can't cross-check them against the sibling
    // message write. The participant list itself is immutable.
    match /conversations/{conversationId} {
      // Admins may read (not write) so they can review the job's chat
      // history when ruling on a dispute. `resource == null` permits a `get`
      // on a not-yet-created conversation — the client checks existence
      // (openConversation) before lazily creating it, and a non-existent doc
      // exposes no data. Without this, that existence check is denied
      // (null `resource.data`) and the very first chat-open always fails.
      allow read: if isSignedIn()
                  && (resource == null
                      || request.auth.uid in resource.data.participantIds
                      || isAdmin());
      allow create: if isSignedIn()
                    && !isSuspended()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;
      // Only the message-preview and unread-counter fields are legitimately
      // client-written (see chat_repository.dart's sendMessage/markRead);
      // `chatClosesAt` (Cloud-Function-owned, gates chatIsOpen()) and
      // `participantIds` must never move through this rule, or a participant
      // could reopen a server-closed chat.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds
                        == resource.data.participantIds
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['lastMessageText', 'lastMessageSenderId',
                                  'lastMessageAt', 'unreadCount']);
      allow delete: if false;

      // Messages are append-only: participants write as themselves; nobody
      // edits or deletes chat history.
      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId))
              .data;
        }
        // The chat is open while `chatClosesAt` is unset or still in the
        // future; a Cloud Function sets it 14 days after the job ends. History
        // stays readable regardless — only new sends are gated.
        function chatIsOpen(conv) {
          return !('chatClosesAt' in conv)
              || conv.chatClosesAt == null
              || request.time < conv.chatClosesAt;
        }
        allow read: if isSignedIn()
                    && (request.auth.uid in conversation().participantIds
                        || isAdmin());
        allow create: if isSignedIn()
                      && !isSuspended()
                      && request.auth.uid in conversation().participantIds
                      && request.resource.data.senderId == request.auth.uid
                      && chatIsOpen(conversation());
        allow update, delete: if false;
      }
    }

    // Append-only wallet ledger; only the Cloud Functions (admin SDK) write
    // it. `participantIds` holds the entry's real uids (never the escrow
    // sentinel), so each party reads only their own history. Admins may read
    // it all — the platform-stats released-volume aggregation needs it.
    match /transactions/{transactionId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.participantIds
                      || isAdmin());
      allow write: if false;
    }

    // Milestone disputes. Readable by the two parties and admins; every
    // mutation goes through the raiseDispute/resolveDispute Cloud Functions
    // (admin SDK bypasses rules), like the transactions ledger above.
    match /disputes/{disputeId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.participantIds
                      || isAdmin());
      allow write: if false;
    }

    // toyyibPay top-up bills. Written only by createToyyibpayBill /
    // creditToyyibpayTopup (admin SDK bypasses rules); the owner may read
    // their own bill's status (e.g. to poll after the WebView returns).
    match /topups/{billCode} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // "Report this user" complaints raised from a public profile. Unlike the
    // disputes/transactions ledgers above (which are server-owned), a client
    // files these directly, so the create rule does the vetting: a reporter
    // may only author a report as themselves, may not report themselves, and
    // must supply a non-empty reason. `status` is pinned to 'open' at
    // creation so a client can't file a pre-resolved report.
    //
    // Read is admin-only: a reporter deliberately cannot list or re-read what
    // they filed, so the collection can never be mined to discover who has
    // been reported. Nothing may edit or delete a report once filed, which
    // keeps the trail auditable.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && !isSuspended()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.reportedUid != request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 2000
                    && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    // Deny everything else by default until its own rules are written.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
