rules_version = '2';

// FairBid Firestore security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's own user doc. Guard with isSignedIn() first.
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && me().role == 'admin';
    }

    function jobTakesOrdinaryBids(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return !('bundleId' in job)
          || get(/databases/$(database)/documents/bundles/$(job.bundleId))
              .data.status != 'open';
    }

    function bundleFields() {
      return ['bundleId', 'bundleOrder', 'bundleTaskCount', 'releasedAt'];
    }
    function noBundleFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(bundleFields());
    }
    // Suspended users can read but not write. Only setUserSuspended sets the flag.
    function isSuspended() {
      return isSignedIn() && me().get('suspended', false) == true;
    }

    // Signed-in users read profiles; owners edit their own, except trust/wallet.
    // TODO: wallet balances are readable by all signed-in users; move to private/.
    match /users/{userId} {
      // Fields only Cloud Functions may write (trust score, job counters).
      function trustFields() {
        return ['trustScore', 'ratingSum', 'ratingCount', 'jobsCompleted',
                'disputesLost', 'trust', 'jobsPosted', 'jobsAssigned',
                'hireRate'];
      }

      // `role` is fixed after sign-up; otherwise anyone could make themselves admin.
      function roleUnchanged() {
        return request.resource.data.get('role', '')
            == resource.data.get('role', '');
      }

      // Users may only set their own verification to 'pending'.
      // Approving or rejecting is for admins only.
      function selfVerificationWriteOk() {
        return request.resource.data.get('verificationStatus', 'none')
                == resource.data.get('verificationStatus', 'none')
            || request.resource.data.get('verificationStatus', 'none')
                == 'pending';
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(
                        trustFields().concat(['suspended', 'suspensionReason',
                                              'suspendedAt', 'suspendedBy']))
                    && request.resource.data
                        .get('walletBalanceSen', 0) == 0
                    && request.resource.data
                        .get('escrowLockedSen', 0) == 0
                    // A new account must be a requestor or provider, not yet verified.
                    && request.resource.data.get('role', '')
                        in ['requestor', 'provider']
                    && request.resource.data
                        .get('verificationStatus', 'none') == 'none';


      allow update: if isSignedIn() && (
                      (request.auth.uid == userId
                          && !isSuspended()
                          && roleUnchanged()
                          && selfVerificationWriteOk()
                          && !request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasAny(trustFields()
                                  .concat(['walletBalanceSen',
                                           'escrowLockedSen', 'suspended',
                                           'suspensionReason', 'suspendedAt',
                                           'suspendedBy', 'verificationReason',
                                           'reviewedAt'])))
                      || (isAdmin()
                          && request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['verificationStatus',
                                        'verificationReason',
                                        'reviewedAt']))
                    );
      allow delete: if false;

      // Reviews: readable by signed-in users. Created only after the job is completed,
      // by one participant for the other. They cannot be edited.
      match /reviews/{reviewId} {
        function jobData(jobId) {
          return get(/databases/$(database)/documents/jobs/$(jobId)).data;
        }

        // A bundled task is reviewed once per bundle, not once per task.
        function expectedReviewId(job, jobId) {
          return ('bundleId' in job ? job.bundleId : jobId)
              + '_' + request.auth.uid;
        }

        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && !isSuspended()
                      && request.resource.data.reviewerId == request.auth.uid
                      && request.auth.uid != userId
                      && jobData(request.resource.data.jobId).status == 'completed'
                      && jobData(request.resource.data.jobId).requestorId
                          in [request.auth.uid, userId]
                      && jobData(request.resource.data.jobId).acceptedProviderId
                          in [request.auth.uid, userId]
                      // Rating must be a whole number from 1 to 5.
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      // One review per reviewer per job (or bundle): the doc id must match.
                      // This stops spam reviews under other doc ids.
                      && reviewId == expectedReviewId(
                          jobData(request.resource.data.jobId),
                          request.resource.data.jobId);
        // Only exception: a review can be flagged once for moderation.
        // Hiding it is done by the moderateReview Cloud Function.
        allow update: if isSignedIn()
                      && resource.data.flagged != true
                      && request.resource.data.flagged == true
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['flagged', 'flagReason', 'flaggedByUid']);
        allow delete: if false;
      }

      // Private data (ID documents, payout details, phone number).
      // Only the owner and admins can read it; the owner writes it.
      match /private/{doc} {
        allow read: if isSignedIn()
                    && (request.auth.uid == userId || isAdmin());
        // Server results and the payout method are written by functions only.
        allow write: if isSignedIn() && request.auth.uid == userId
                     && !(doc in ['ssmExtract', 'idExtract', 'payoutMethod']);
      }

      // Only Cloud Functions create notifications. The owner may only change `read`.
      match /notifications/{notificationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow update: if isSignedIn() && request.auth.uid == userId
                      && request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    function ownsJob(jobId) {
      return get(/databases/$(database)/documents/jobs/$(jobId))
          .data.requestorId == request.auth.uid;
    }

        function isAcceptedProvider(jobId) {
          return get(/databases/$(database)/documents/jobs/$(jobId))
              .data.acceptedProviderId == request.auth.uid;
        }


    function isApprovedProvider() {
      return me().role == 'provider' && me().verificationStatus == 'approved';
    }
    // Bidding is open while status is 'open' and the deadline has not passed.
    // This also blocks late bids before the expiry sweep runs.
    function jobBiddingOpen(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return job.status == 'open'
          && (!('deadline' in job) || request.time < job.deadline);
    }

    // Clients may only cancel an open job. Every other status change
    // (accept, complete, cancel later) goes through a Cloud Function.
    function jobStatusWriteOk() {
      return request.resource.data.status == resource.data.status
          || (resource.data.status == 'open'
              && request.resource.data.status == 'cancelled');
    }

    // Cancellation fields are server-owned, or a requestor could fake a request.
    function noCancelFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['cancellationRequestedBy', 'cancellationReason',
                   'cancellationRequestedAt', 'cancelledAt', 'cancelledBy']);
    }

    // A task in an open bundle cannot be cancelled alone. Use cancelBundle.
    function bundleTaskStatusWriteOk() {
      return request.resource.data.status == resource.data.status
          || !('bundleId' in resource.data)
          || get(/databases/$(database)/documents/bundles/$(resource.data.bundleId))
              .data.status != 'open';
    }

    // Accept fields are server-owned (acceptBid), so the wallet check cannot be skipped.
    // `fundedAtAward` is set by acceptBid, so clients must not change it.
    function noAcceptFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['acceptedProviderId', 'acceptedProviderName',
                   'acceptedBidAmountSen', 'fundedAtAward']);
    }

    // Price-change fields are server-owned, so a price cannot change without consent.
    function noPriceChangeFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['priceChangeRequest', 'originalBidAmountSen',
                   'priceChangeCount']);
    }

    // Appointment fields are server-owned, so a visit time needs both parties' consent.
    function scheduleFields() {
      return ['schedulingRequired', 'appointment', 'appointmentProposal',
              'appointmentChanges', 'lateRescheduleBy',
              'onTheWayAt', 'etaMinutes', 'arrivedAt'];
    }
    function noScheduleFieldWrites() {
      return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(scheduleFields());
    }

    // A job that needs a visit time can only be delivered once it is confirmed.
    function jobScheduleReady(jobId) {
      let job = get(/databases/$(database)/documents/jobs/$(jobId)).data;
      return !job.get('schedulingRequired', false)
          || job.get('appointment', {}).get('confirmedAt', null) != null;
    }

    // Jobs: signed-in users read. Only a requestor creates their own job, and only
    // the owner edits it. Anyone may change `bidCount` (the bid counter).
    match /jobs/{jobId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && !isSuspended()
                    && request.resource.data.requestorId == request.auth.uid
                    && me().role == 'requestor'
                    && !request.resource.data.keys().hasAny(bundleFields())
                    && !('fundedAtAward' in request.resource.data)
                    && !request.resource.data.keys().hasAny(scheduleFields());
      allow update: if isSignedIn()
                    && ((resource.data.requestorId == request.auth.uid
                         && jobStatusWriteOk()
                         && noCancelFieldWrites()
                         && noAcceptFieldWrites()
                         && noPriceChangeFieldWrites()
                         && noScheduleFieldWrites()
                         && noBundleFieldWrites()
                         && bundleTaskStatusWriteOk())
                        || request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['bidCount']));
      allow delete: if false;

      // Bids: one per provider, keyed by provider uid. Only approved providers write.
      // Accepting is server-only; a provider can withdraw their own bid.
      match /bids/{bidId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
                              && !isSuspended()
                              && request.auth.uid == bidId
                              && request.resource.data.providerId == bidId
                              && isApprovedProvider()
                              && jobBiddingOpen(jobId)
                              && jobTakesOrdinaryBids(jobId)
                              // Accepting is server-only, so a bid can only be written as pending.
                              && request.resource.data.status == 'pending'
                              // Amount must be a positive int up to RM 1,000,000 (acceptBid trusts it).
                              && request.resource.data.amountSen is int
                              && request.resource.data.amountSen > 0
                              && request.resource.data.amountSen <= 100000000
                              // Trust Score and photo must match the caller's own profile, not made-up values.
                              && request.resource.data.providerTrustScore
                                  == me().get('trustScore', 0)
                              && request.resource.data
                                  .get('providerScoreVisible', false)
                                  == me().get('trust', {}).get('scoreVisible', false)
                              && request.resource.data
                                  .get('providerPhotoUrl', null)
                                  == me().get('profilePhotoUrl', null);
        // Withdraw only while pending, so an accepted bid cannot be deleted.
        allow delete: if isSignedIn() && request.auth.uid == bidId
                      && resource.data.status == 'pending';
      }

      // Milestones and money moves are written by Cloud Functions.
      // Clients may only mark a funded milestone as submitted, once any
      // required visit time is confirmed.
      match /milestones/{milestoneId} {
        allow read: if isSignedIn()
                    && (ownsJob(jobId) || isAcceptedProvider(jobId));
        allow create: if false;
        allow update: if isSignedIn() && !isSuspended()
                      && isAcceptedProvider(jobId)
                      && jobScheduleReady(jobId)
                      && resource.data.status == 'funded'
                      && request.resource.data.status == 'submitted'
                      && request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['status', 'submissionNote']);
        allow delete: if false;
      }

      // Job activity log: written only by Cloud Functions, so it cannot be forged.
      // Readable by the job's two participants and admins.
      match /events/{eventId} {
        allow read: if isSignedIn()
                    && (ownsJob(jobId) || isAcceptedProvider(jobId) || isAdmin());
        allow write: if false;
      }

      // Exact service address. Readable by the owner, accepted provider and admins only.
      // Written by the owner.
      match /private/{docId} {
        allow read: if isSignedIn()
                    && (ownsJob(jobId) || isAcceptedProvider(jobId) || isAdmin());
        allow create, update: if isSignedIn() && !isSuspended() && ownsJob(jobId);
        allow delete: if false;
      }
    }
    match /bundles/{bundleId} {
      allow read: if isSignedIn();
      allow write: if false;

      // Sealed bids by bidder uid, readable only by the bidder and requestor.
      // Writes go through callables, since rules cannot check per-task prices.
      match /bundleBids/{providerId} {
        allow read: if isSignedIn()
                    && (request.auth.uid == providerId
                        || request.auth.uid == get(/databases/$(database)/documents/bundles/$(bundleId)).data.requestorId);
        allow write: if false;
      }
    }

    // Collection-group reads so a provider can list their own bids and milestones.
    // Each query filters on providerId == the caller, which is checked here.
    match /{path=**}/bids/{bidId} {
      allow read: if isSignedIn()
                  && resource.data.providerId == request.auth.uid;
    }

    // Same for a provider's bundle bids (Pending Bids).
    match /{path=**}/bundleBids/{bidId} {
      allow read: if isSignedIn()
                  && resource.data.providerId == request.auth.uid;
    }
    match /{path=**}/milestones/{milestoneId} {
      allow read: if isSignedIn()
                  && resource.data.providerId == request.auth.uid;
    }
    // Admin moderation queue: the flagged-reviews collectionGroup query.
    match /{path=**}/reviews/{reviewId} {
      allow read: if isAdmin();
    }

    // Chat between a job's requestor and accepted provider (id `{jobId}_{providerId}`).
    // Only participants read/update it; the participant list cannot change.
    match /conversations/{conversationId} {
      // Admins can read chats to rule on disputes. `resource == null` lets the client
      // check whether a chat exists before creating it.
      allow read: if isSignedIn()
                  && (resource == null
                      || request.auth.uid in resource.data.participantIds
                      || isAdmin());
      allow create: if isSignedIn()
                    && !isSuspended()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.participantIds.size() == 2;
      // Clients may only write the last-message and unread fields, so
      // `chatClosesAt` and `participantIds` cannot be changed.
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participantIds
                    && request.resource.data.participantIds
                        == resource.data.participantIds
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly(['lastMessageText', 'lastMessageSenderId',
                                  'lastMessageAt', 'unreadCount']);
      allow delete: if false;

      // Messages are append-only: no edits or deletes.
      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId))
              .data;
        }
        // Chat is open until `chatClosesAt` (set by a Cloud Function).
        // Old messages stay readable; only new sends are blocked.
        function chatIsOpen(conv) {
          return !('chatClosesAt' in conv)
              || conv.chatClosesAt == null
              || request.time < conv.chatClosesAt;
        }
        allow read: if isSignedIn()
                    && (request.auth.uid in conversation().participantIds
                        || isAdmin());
        allow create: if isSignedIn()
                      && !isSuspended()
                      && request.auth.uid in conversation().participantIds
                      && request.resource.data.senderId == request.auth.uid
                      && chatIsOpen(conversation());
        allow update, delete: if false;
      }
    }

    // Wallet ledger: written only by Cloud Functions. Users read their own entries,
    // admins read all of them.
    match /transactions/{transactionId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.participantIds
                      || isAdmin());
      allow write: if false;
    }

    // Disputes: readable by the two parties and admins; written only by Cloud Functions.
    match /disputes/{disputeId} {
      allow read: if isSignedIn()
                  && (request.auth.uid in resource.data.participantIds
                      || isAdmin());
      allow write: if false;
    }

    // Top-up bills: written by Cloud Functions; the owner can read their own bill.
    match /topups/{billCode} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // User reports: clients file them as themselves, with a reason, status 'open'.
    // Only admins can read them, so reported users stay hidden. No edits or deletes.
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
                    && !isSuspended()
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.reportedUid is string
                    && request.resource.data.reportedUid != request.auth.uid
                    && request.resource.data.reason is string
                    && request.resource.data.reason.size() > 0
                    && request.resource.data.reason.size() <= 2000
                    && request.resource.data.status == 'open';
      allow update, delete: if false;
    }

    // Deny everything else (incl. the server-only idRegistry).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
